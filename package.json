{
	"name": "billing",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:drafts": "tsx --test src/lib/bill-drafts.test.ts src/lib/server/bill-drafts.test.ts src/lib/bill-draft-autosave.test.ts 'src/routes/api/bill-drafts/[draftKey]/draft-api.test.ts'",
		"test:drafts:contracts": "tsx --test src/lib/bill-drafts.test.ts",
		"test:drafts:repository": "tsx --test src/lib/server/bill-drafts.test.ts",
		"test:drafts:controller": "tsx --test src/lib/bill-draft-autosave.test.ts",
		"test:drafts:api": "tsx --test 'src/routes/api/bill-drafts/[draftKey]/draft-api.test.ts'",
		"seed:demo": "npx tsx scripts/seed-example-bill.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/better-sqlite3": "^7.6.13",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@lucide/svelte": "^1.17.0",
		"better-sqlite3": "^12.10.0",
		"lucide-svelte": "^1.0.1",
		"playwright": "^1.61.1",
		"xlsx": "^0.18.5",
		"xlsx-js-style": "^1.2.0"
	}
}
